{
  "name": "quizarena",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate --workspace=@quizarena/server",
    "db:migrate": "npm run db:migrate --workspace=@quizarena/server"
  },
  "devDependencies": { "turbo": "^2.3.3" }
}
